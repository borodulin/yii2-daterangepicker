{
    "name": "conquer/daterangepicker",
    "description": "Yii2 Date Range Picker widget",
    "keywords": [
        "yii2",
        "extension",
        "widget",
        "date",
        "range",
        "picker"
    ],
    "homepage": "https://github.com/borodulin/yii2-daterangepicker",
    "type": "yii2-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrey Borodulin",
            "email": "borodulin@gmail.com",
            "homepage": "https://github.com/borodulin/yii2-daterangepicker"
        }
    ],
    "extra": {
        "branch-alias": {
            "dev-master": "2.0.x-dev"
        }
    },
    "require": {
        "php": "^7.4 || ^8.0",
        "yiisoft/yii2": "~2.0.14",
        "conquer/momentjs": "^1.2",
        "conquer/helpers": "^2.0.7",
        "bower-asset/bootstrap-daterangepicker": "^3.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "conquer\\daterangepicker\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "conquer\\daterangepicker\\tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    }
}
